{
  "name": "giving-the-distance-app",
  "version": "0.1.0",
  "description": "Turn every mile into meaningful impact. Connect your Strava account and create sponsorships where sponsors pay per mile or kilometer you run.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "config:audit": "node scripts/audit-config.mjs",
    "env:sanitize": "node scripts/sanitize-env-files.mjs .env.local .env.preview .env.production",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "postinstall": "prisma generate",
    "backup:gpx-blobs": "node scripts/backup-gpx-blobs.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@logtail/node": "^0.5.8",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.0.0",
    "bootstrap-icons": "^1.13.1",
    "leaflet": "^1.9.4",
    "next": "16.0.8",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^6.19.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.0.16",
    "baseline-browser-mapping": "^2.10.18",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "happy-dom": "^20.0.11",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
