// Prisma schema for Giving the Distance
// Database: Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// NextAuth.js Models
// ============================================

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  name                       String?
  image                      String?
  emailVerified              DateTime?
  selectedCharityId          String?   // User's current selected charity (for quick access)
  defaultActivityIsPublic    Boolean   @default(true) // Default visibility for newly imported activity titles/profile
  defaultActivityMapIsPublic Boolean   @default(false) // Default visibility for route maps on public activity pages
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  stravaAthlete      StravaAthlete?
  activities         Activity[]
  selectedCharity    Charity? @relation(fields: [selectedCharityId], references: [id])
  charitySelections  CharitySelection[] // Full history of charity selections
  charityCommitments CharityCommitment[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// App-Specific Models
// ============================================

model StravaAthlete {
  id                  String   @id @default(cuid())
  userId              String   @unique
  stravaAthleteId     BigInt   @unique
  username            String?
  firstname           String?
  lastname            String?
  city                String?
  state               String?
  country             String?
  sex                 String?
  profileMedium       String?
  profile             String?
  stravaAuthorized    Boolean  @default(true)
  permissionsGranted  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorMatches SponsorMatch[]

  @@map("strava_athletes")
}

model Activity {
  id                   String    @id @default(cuid())
  userId               String
  stravaActivityId     BigInt    @unique
  shortcode            String?   @unique // 5-character shortcode for public URLs
  name                 String?
  type                 String    // Run, Ride, Swim, Walk, etc.
  distanceMeters       Decimal?  @db.Decimal(10, 2)
  movingTimeSeconds    Int?
  elapsedTimeSeconds   Int?
  totalElevationGain   Decimal?  @db.Decimal(10, 2)
  startDate            DateTime?
  startDateLocal       DateTime?
  timezone             String?
  isManual             Boolean   @default(false)
  isPrivate            Boolean   @default(false)
  isPublicProfile      Boolean   @default(false) // User can make their profile public on this activity
  isPublicRouteMap     Boolean   @default(false) // User can share this activity's route map on its public page
  gpxBlobUrl           String?   // URL to GPX file in Vercel Blob Storage
  deletedAt            DateTime? // Soft delete - null means not deleted
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorMatches     SponsorMatch[]
  charityCommitments CharityCommitment[]
  historyEntries     StravaActivityHistory[]
  notifications      ActivityNotification[]

  @@index([userId])
  @@index([startDate(sort: Desc)])
  @@index([type])
  @@index([deletedAt]) // Index for filtering deleted activities
  @@index([shortcode]) // Index for shortcode lookups
  @@map("activities")
}

model ActivityNotification {
  id         String   @id @default(cuid())
  activityId String
  type       String
  status     String   @default("PENDING")
  sentAt     DateTime?
  lastError  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, type])
  @@index([activityId])
  @@index([type])
  @@index([status])
  @@map("activity_notifications")
}

model StravaWebhookSubscription {
  id                String   @id @default(cuid())
  subscriptionId    BigInt   @unique
  callbackUrl       String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("strava_webhook_subscriptions")
}

model StravaWebhookEvent {
  id                      String   @id @default(cuid())
  objectType              String   // "activity" or "athlete"
  objectId                BigInt
  aspectType              String   // "create", "update", "delete"
  ownerId                 BigInt   // Strava athlete ID
  subscriptionId          BigInt
  eventTime               DateTime
  updates                 Json?    // Any updates data
  processed               Boolean  @default(false)
  processingError         String?  @db.Text
  descriptionUpdated      Boolean  @default(false) // Whether activity description was updated
  descriptionUpdateError  String?  @db.Text // Error message if description update failed
  rawPayload              Json     // Full webhook payload for debugging
  createdAt               DateTime @default(now())

  historyEntries StravaActivityHistory[]

  @@index([objectType])
  @@index([ownerId])
  @@index([processed])
  @@index([eventTime(sort: Desc)])
  @@map("strava_webhook_events")
}

model StravaActivityHistory {
  id                    String   @id @default(cuid())
  activityId            String?
  stravaActivityId      BigInt
  webhookEventId        String?
  source                String   // "strava_webhook" or "app"
  eventType             String   // "activity_snapshot", "activity_deleted", etc.
  aspectType            String?
  name                  String?
  type                  String?
  isPrivate             Boolean?
  visibility            String?
  descriptionText       String?  @db.Text
  descriptionPresent    Boolean?
  descriptionHasGtdMarker Boolean?
  descriptionLength     Int?
  updates               Json?
  metadata              Json?
  createdAt             DateTime @default(now())

  activity    Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  webhookEvent StravaWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([stravaActivityId])
  @@index([webhookEventId])
  @@index([createdAt(sort: Desc)])
  @@map("strava_activity_history")
}

model Charity {
  id                     String   @id
  name                   String
  fullName               String
  description            String   @db.Text
  category               String
  logoUrl                String?
  website                String
  charityNavigatorScore  Int
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users              User[]
  charitySelections  CharitySelection[]
  charityCommitments CharityCommitment[]

  @@map("charities")
}

model CharitySelection {
  id         String   @id @default(cuid())
  userId     String
  charityId  String
  selectedAt DateTime @default(now())
  isActive   Boolean  @default(true) // Current selection vs historical

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charity Charity @relation(fields: [charityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([charityId])
  @@index([selectedAt(sort: Desc)])
  @@index([userId, isActive]) // Query active selections efficiently
  @@map("charity_selections")
}

// ============================================
// Sponsor & Campaign Models
// ============================================

model Sponsor {
  id           String   @id
  name         String
  businessName String
  slug         String   @unique
  website      String?
  address      Json?    // Store address as JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns Campaign[]

  @@map("sponsors")
}

model Campaign {
  id                   String   @id @default(cuid())
  sponsorId            String
  name                 String
  budgetRemainingCents Int      // Current remaining budget
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sponsor            Sponsor             @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  topUps             CampaignTopUp[]
  sponsorMatches     SponsorMatch[]
  charityCommitments CharityCommitment[]

  @@index([sponsorId])
  @@index([isActive])
  @@map("campaigns")
}

model CampaignTopUp {
  id          String   @id @default(cuid())
  campaignId  String
  amountCents Int      // Amount added to campaign budget
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_top_ups")
}

model SponsorMatch {
  id               String             @id @default(cuid())
  activityId       String             // Foreign key to Activity
  stravaActivityId BigInt             // Also store Strava ID for reference
  athleteId        String             // Foreign key to StravaAthlete
  stravaAthleteId  BigInt             // Also store Strava athlete ID
  campaignId       String?            // Nullable if no match
  matchedAt        DateTime           @default(now())
  result           SponsorMatchResult // Enum for match status
  matchingVersion  String?
  decisionReason   String?
  decisionContext  Json?
  decrementCents   Int                @default(0)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())

  activity Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  athlete  StravaAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([activityId]) // Idempotency: one sponsor match per activity
  @@index([athleteId])
  @@index([campaignId])
  @@index([result])
  @@map("sponsor_matches")
}

model CharityCommitment {
  id          String   @id @default(cuid())
  userId      String
  charityId   String
  campaignId  String
  activityId  String   // Foreign key to Activity
  amountCents Int      // Commitment amount (typically 10 cents)
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charity  Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([charityId])
  @@index([campaignId])
  @@index([activityId])
  @@map("charity_commitments")
}

enum SponsorMatchResult {
  MATCHED
  SKIPPED_NO_BUDGET
  SKIPPED_NO_ACTIVE_CAMPAIGN
  SKIPPED_ALREADY_SPONSORED
  SKIPPED_PRIVATE_ACTIVITY
  SKIPPED_OUTSIDE_NYC
  SKIPPED_NO_SELECTED_CHARITY
  SKIPPED_UPDATE_FAILED
}
